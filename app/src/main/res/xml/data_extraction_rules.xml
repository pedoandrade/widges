<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Fotos e preferências dos widgets nunca saem do dispositivo -->
    <cloud-backup>
        <exclude domain="file" path="widget_photos/" />
        <exclude domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="widget_photos/" />
        <exclude domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
